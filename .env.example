# ─────────────────────────────────────────────────────────────────────────────
# The Morning Shelf — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel Project Settings.
# NOTHING SECRET BELONGS IN THE REPO OR IN THE RENDERED HTML.
# ─────────────────────────────────────────────────────────────────────────────

# --- Claude via Vercel AI Gateway -------------------------------------------
# The Vercel AI SDK routes model calls through the AI Gateway automatically when
# this key is present. On Vercel, OIDC can supply it instead — see README.
AI_GATEWAY_API_KEY=

# Gateway model slugs (provider/model). Override to pin a specific Claude model.
MODEL_DRAFTER=anthropic/claude-sonnet-4.5
MODEL_CRITIC=anthropic/claude-sonnet-4.5

# --- Neon Postgres -----------------------------------------------------------
# Pooled connection string from the Neon dashboard (ends with ?sslmode=require).
DATABASE_URL=

# --- Cron / admin protection -------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`. Also used to
# guard /admin/holds and the manual pipeline trigger.
CRON_SECRET=

# --- Quotes ------------------------------------------------------------------
# Default quotes provider is Stooq (free, keyless, end-of-day). No key needed.
# Set to override the base URL if you proxy it.
QUOTES_BASE_URL=https://stooq.com

# --- Site --------------------------------------------------------------------
# Absolute base URL of the deployed site; used to build web-version + archive
# links inside the (self-contained) issue HTML.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
