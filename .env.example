# ─────────────────────────────────────────────────────────────────────────────
# The Morning Shelf — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel Project Settings.
# NOTHING SECRET BELONGS IN THE REPO OR IN THE RENDERED HTML.
# ─────────────────────────────────────────────────────────────────────────────

# --- Claude access -----------------------------------------------------------
# Preferred: call the Anthropic API directly with your own key. When this is set,
# the Vercel AI Gateway (and its credit-card requirement) is bypassed entirely.
ANTHROPIC_API_KEY=

# Fallback: route through the Vercel AI Gateway. Used only when ANTHROPIC_API_KEY
# is unset (on Vercel, OIDC can supply this instead).
AI_GATEWAY_API_KEY=

# Model ids. For the direct Anthropic path use a native id (e.g. claude-sonnet-4-5);
# a leading "anthropic/" is stripped automatically. For the Gateway path the
# provider prefix is added if absent.
MODEL_DRAFTER=claude-sonnet-4-5
MODEL_CRITIC=claude-sonnet-4-5

# --- Neon Postgres -----------------------------------------------------------
# Pooled connection string from the Neon dashboard (ends with ?sslmode=require).
DATABASE_URL=

# --- Cron / admin protection -------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`. Also used to
# guard /admin/holds and the manual pipeline trigger.
CRON_SECRET=

# --- Quotes ------------------------------------------------------------------
# Default quotes provider is Stooq (free, keyless, end-of-day). No key needed.
# Set to override the base URL if you proxy it.
QUOTES_BASE_URL=https://stooq.com

# --- Site --------------------------------------------------------------------
# Absolute base URL of the deployed site; used to build web-version + archive
# links inside the (self-contained) issue HTML.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
